# Copy this file's content into Streamlit Cloud's app settings under
# "Secrets" (or into a local .streamlit/secrets.toml for testing) —
# do NOT commit a real secrets.toml with real passwords to GitHub.
# .gitignore already excludes .streamlit/secrets.toml.

cookie_name = "pulse_auth"
cookie_key = "change-this-to-a-long-random-string"

[credentials.usernames.admin]
email = "admin@example.com"
name = "Admin"
password = "choose-a-strong-password"   # plain text here — the app hashes it automatically

[credentials.usernames.sales_team]
email = "sales@example.com"
name = "Sales Team"
password = "another-strong-password"

# Add as many [credentials.usernames.<login_id>] blocks as you need users.
# Without this file, the app falls back to a demo login:
#   username: admin / password: admin123 — fine for local testing only.
